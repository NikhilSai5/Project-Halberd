# Public client values only. Never put the PostgreSQL password or service-role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_GOOGLE_EXTENSION_CLIENT_ID=your-chrome-extension-client-id.apps.googleusercontent.com

